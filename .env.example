# alauda-app environment template
#
# Variable names follow Local_Map_SEO PR #19 NextAuth setup.
# Phase 0 fills these from alauda-app's OWN dedicated services
# (NOT under Yifan's source-repo accounts — see docs/BLUEPRINT.md
# Phase 0 isolation rules).

# === Database (Neon Postgres + PostGIS) ===
# alauda-app's own Neon project, NOT Yifan's.
# Provided by Vercel Postgres / Neon integration on prod;
# locally point at a Neon dev branch.
DATABASE_URL=
POSTGRES_URL_NON_POOLING=

# === Queue (Upstash Redis, alauda-app's own instance) ===
# NOT shared with Local_Map_SEO's Redis — would cause BullMQ cross-talk.
REDIS_URL=

# === Auth (NextAuth v5; lifted from Local_Map_SEO PR #19) ===
AUTH_SECRET=
APP_URL=http://localhost:3000

# Google OAuth provider (NextAuth v5 standard env names)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend magic-link provider — variable name follows PR #19's choice.
# NextAuth v5 default is AUTH_RESEND_KEY; PR #19 may reuse RESEND_API_KEY below.
# Read Local_Map_SEO PR #19's auth.config.ts (likely apps/web/src/auth.config.ts
# or src/auth.config.ts — grep for `Resend` in the PR diff) to confirm. Do NOT
# redecide; whichever name PR #19 picked is alauda-app's name.
# AUTH_RESEND_KEY=

# === Email (Resend) ===
# Same Resend account as Yifan ok; alauda-app uses its own NEW sender domain
# (e.g. noreply@app.alauda.ai) to keep send-reputation isolated.
RESEND_API_KEY=
RESEND_FROM=

# === SMS (Twilio) — alauda-app's own NEW number ===
# Review_MLP's number stays with its production. Sharing one number = SMS
# replies confused between products.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# === Cron (Vercel Cron — Pro plan required, inherited from Review_MLP) ===
CRON_SECRET=

# === AI (Reviews) — same Anthropic key OK to reuse ===
# No shared write state; just rate-limited reads.
ANTHROPIC_API_KEY=

# === SERP (Scan) — same Serper / DataForSEO key OK to reuse ===
SERPER_API_KEY=
SERP_QPS=
SERP_WORKER_CONCURRENCY=

# === Places (shared) — same Google Places key OK to reuse ===
GOOGLE_PLACES_API_KEY=

# === Map (Scan) — same Mapbox token OK to reuse ===
NEXT_PUBLIC_MAPBOX_TOKEN=
