{
  "name": "@alauda/base",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e .env.local -- prisma generate --schema=../../packages/db/prisma/schema.prisma",
    "db:push": "dotenv -e .env.local -- prisma db push --schema=../../packages/db/prisma/schema.prisma --skip-generate"
  },
  "dependencies": {
    "@alauda/db": "workspace:*",
    "@alauda/shared": "workspace:*",
    "@auth/prisma-adapter": "^2.7.4",
    "next": "^14.2.35",
    "next-auth": "5.0.0-beta.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  }
}
