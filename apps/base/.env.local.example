# apps/base — copy to .env.local. SQLite for demo (zero cost).
# To switch to Postgres / Supabase later: change DATABASE_URL to the
# postgres connection string and update schema.prisma provider.

# SQLite file lives next to this .env.local at apps/base/dev.db
DATABASE_URL="file:../../../apps/base/dev.db"

# NextAuth — base's own secret
AUTH_SECRET="run: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Resend — magic-link email. For demo without sending real emails, leave
# placeholder; the magic-link URL will be logged to the dev console.
AUTH_RESEND_KEY="re_placeholder"
AUTH_RESEND_FROM="onboarding@resend.dev"
